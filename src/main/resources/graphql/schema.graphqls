type Post {
    id: ID!
    title: String!
    content: String!
}

type Comment {
    id: ID!
    text: String!
    postId: ID!
}

type User {
    id: ID!
    username: String!
    email: String!
}

# Define the union type
union SearchResult = Post | Comment | User

# Example query using the union
type Query {
    search: [SearchResult!]!
}